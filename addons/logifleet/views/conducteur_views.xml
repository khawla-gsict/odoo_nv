<odoo>
	<record id="view_conducteur_list" model="ir.ui.view">
		<field name="name">logifleet.conducteur.list</field>
		<field name="model">logifleet.conducteur</field>
		<field name="arch" type="xml">
			<list string="Conducteurs">
				<field name="nom"/>
				<field name="adresse"/>
				<field name="type_permis"/>
				<field name="num_permis"/>
				<field name="disponibilite"/>
			</list>
		</field>
	</record>
	<record id="view_conducteur_form" model="ir.ui.view">
		<field name="name">logifleet.conducteur.form</field>
		<field name="model">logifleet.conducteur</field>
		<field name="arch" type="xml">
			<form string="Ajouter conducteur">
				<sheet>
					<group>
						<field name="nom"/>
						<field name="adresse"/>
						<field name="type_permis"/>
						<field name="num_permis"/>
						<field name="disponibilite"/>
					</group>
				</sheet>
			</form>
		</field>
		
	</record>
	<record id="action_conducteur" model="ir.actions.act_window">
		<field name="name">Conducteur</field>
		<field name="res_model">logifleet.conducteur</field>
		<field name="view_mode">list,form</field>
	</record>
</odoo>