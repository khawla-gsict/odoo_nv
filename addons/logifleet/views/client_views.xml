	<odoo>
		<record model="ir.ui.view" id="client_form_view">
			<field name="name">logifleet.client.form</field>
			<field name="model">logifleet.client</field>
			<field name="arch" type="xml">
				<form>
					<group>
						<field  name="name"/>
						<field  name="adresse"/>
		
						<field  name="type_client"/>

					</group>
					

				</form>
			</field>
		</record>
		<record id="view_client_list" model="ir.ui.view">
			<field name="name">client.list</field>
			<field name="model">logifleet.client</field>
			<field name="arch" type="xml">
				<list string="Clients">
					<field  name="name"/>
					<field  name="adresse"/>

					<field  name="type_client"/>

				</list>
			</field>
		</record>
		<record id="view_client_kanban" model="ir.ui.view">
			<field name="name">logifleet.client.kanban,view</field>
			<field name="model">logifleet.client</field>
			<field name="arch" type="xml">
				<kanban>
					<field  name="name"/>
					<field  name="adresse"/>

					<field  name="type_client"/>

					<templates>
						<t t-name="kanban-box">
							<div t-attf-class="oe_kanban_global_click">
								<div>
									<strong class="o_kanban_record_title">
										<span>
											<field  name="name"/>
										</span>
									</strong>
								</div>
								<p>
									Information supplementaire:
								</p>
								<div>
									<span class="text-muted o_kanban_record_subtitle">
										<field  name="name"/>
										<field  name="adresse"/>

										<field  name="type_client"/>
									

									</span>
								</div>

							</div>
						</t>
					</templates>
				</kanban>
			</field>
		</record>
		<!-- Action pour ouvrir la vue -->
		<record id="client_action" model="ir.actions.act_window">
			<field name="name">Clients</field>
			<field name="res_model">logifleet.client</field>
			<field name="view_mode">list,form,kanban</field>
			<field name="help" type="html">
				<p class="o_view_nocontent_smiling_face">
					Create new asset model
				</p>
			</field>
		</record>




	</odoo>

