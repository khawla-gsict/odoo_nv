<!-- mission/views/pointage_views.xml -->
<odoo>
	<!-- Wizard form -->
	<record id="view_timesheet_wizard_form" model="ir.ui.view">
		<field name="name">mission.timesheet.wizard.form</field>
		<field name="model">mission.timesheet.wizard</field>
		<field name="arch" type="xml">
			<form string="Générer Timesheet Mensuel">
				<sheet>
					<group>
						<field name="client_id"/>
						<field name="date_start"/>
						<field name="date_end"/>
					</group>
					<footer>
						<button name="generate_timesheet" type="object" string="Générer" class="btn-primary"/>
						<button name="action_export_xlsx" type="object" string="Exporter Excel" class="btn-secondary"/>
						<button name="action_export_pdf" type="object" string="Exporter PDF" class="btn-secondary"/>

						<button string="Fermer" class="btn-secondary" special="cancel"/>
					</footer>
				</sheet>

				<div class="o_form_field_row">
					<label for="html_table"/>
					<field name="html_table" widget="html" nolabel="1"/>
				</div>

				<!-- Download binary (invisible field shown by URL action) -->
				<field name="export_file" invisible="1"/>
				<field name="export_filename" invisible="1"/>
			</form>
		</field>
	</record>

	<!-- Wizard action -->
	<record id="action_timesheet_wizard" model="ir.actions.act_window">
		<field name="name">Générer Timesheet Mensuel</field>
		<field name="res_model">mission.timesheet.wizard</field>
		<field name="view_mode">form</field>
		<field name="target">new</field>
	</record>


</odoo>
