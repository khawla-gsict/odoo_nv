<odoo>
	<template id="report_ordre_mission_template">
		<t t-call="web.html_container">
			<t t-foreach="docs" t-as="o">
				<div class="page">
					<h2 style="text-align:center;">Ordre de Mission</h2>
					<p>
						<strong>Titre :</strong>
						<t t-esc="o.titre_mission"/>
					</p>
					<p>
						<strong>Véhicule :</strong>
						<t t-esc="o.vehicule_id.matricule"/>
					</p>
					<p>
						<strong>Conducteur :</strong>
						<t t-esc="o.conducteur_id.nom"/>
					</p>
					<p>
						<strong>Date début :</strong>
						<t t-esc="o.date_debut"/>
					</p>
					<p>
						<strong>Date fin :</strong>
						<t t-esc="o.date_fin"/>
					</p>
					<p>
						<strong>Adresse départ :</strong>
						<t t-esc="o.adresse_depart"/>
					</p>
					<p>
						<strong>Adresse arrivée :</strong>
						<t t-esc="o.adresse_arrive"/>
					</p>
					<p>
						<strong>Kilométrage :</strong> <t t-esc="o.km"/> km
					</p>
					<p>
						<strong>Coût total :</strong> <t t-esc="o.cout_total"/> DA
					</p>
				</div>
			</t>
		</t>
	</template>
</odoo>
